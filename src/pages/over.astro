---
import DefaultLayout from '../layouts/DefaultLayout.astro';

import Features from "../components/generic/features"


import * as OverContent from '../../content/pages/over.mdx'
import OverData from '../../content/pages/over.json' assert { type: 'json' };

console.log("Overdata in Over.astro:", OverData);

const { title, description } = OverContent.frontmatter;
---


<DefaultLayout title={title} metaDescription={description}>
    <OverContent.Content />
    <Features features={OverData.features} client:only="react" />
</DefaultLayout>